# App config. Copy to .env (gitignored). .env is bundled into the app as an asset, so anyone with the
# app can read it: only public values belong here, never secrets.

# Backend URL, no trailing slash. Android emulator -> your PC's localhost: http://10.0.2.2:8080
BASE_URL=http://10.0.2.2:8080

# Google Sign-In (Google Cloud project goaway-483709). Client IDs are public identifiers, not secrets.
# Web client: the app requests ID tokens for this audience (serverClientId); the backend only accepts it.
GOOGLE_WEB_CLIENT_ID=1018541563002-sft2jld5f3n6lnenvt0pk8hknk7hfq9n.apps.googleusercontent.com
# iOS client: identifies the iOS app (bundle ID com.goawayofficial.app) to Google.
GOOGLE_IOS_CLIENT_ID=1018541563002-ss0dur7e8d4l9c2lb2o89edgouqrd2fv.apps.googleusercontent.com
# Android needs no client ID in the app: Google matches the package name (com.goawayofficial.app) and the
# signing certificate's SHA-1 to the Android OAuth client. Each developer's debug SHA-1 must be registered.
